<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="res.groups.privilege" id="privilege_portal_timesheet_approvals">
            <field name="name">Portal Timesheet Approvals</field>
            <field name="category_id" ref="ucs_portal_self_service.module_category_portal_approvals"/>
        </record>

        <record id="group_portal_timesheet_approval_manager" model="res.groups">
            <field name="name">Timesheet Manager</field>
            <field name="privilege_id" ref="privilege_portal_timesheet_approvals"/>
            <field name="comment">Can approve timesheets for their subordinates.</field>
        </record>

        <record id="group_portal_timesheet_approval_admin" model="res.groups">
            <field name="name">Timesheet Administrator</field>
            <field name="privilege_id" ref="privilege_portal_timesheet_approvals"/>
            <field name="implied_ids" eval="[(4, ref('group_portal_timesheet_approval_manager'))]"/>
            <field name="comment">Can approve all timesheets.</field>
        </record>
    </data>
</odoo>
