<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily Timesheet Shortfall Notification Cron -->
        <record id="ir_cron_timesheet_shortfall_notifications" model="ir.cron">
            <field name="name">Daily Timesheet Shortfall Notification to Managers</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_timesheet_shortfall_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
