<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_profile" name="My Profile">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Profile</t>
            </t>
            
            <div class="ess-hist-hero" style="margin-top: 0; margin-bottom: 20px;">
                <div class="ess-hist-hero-inner">
                    <div>
                        <div class="ess-hist-hero-title">
                            <i class="fa fa-user-circle"/> My Profile
                        </div>
                        <div class="ess-hist-hero-sub">View your information and update emergency contacts</div>
                    </div>
                    <a href="/my/dashboard" class="ess-hist-back-btn ml-3">
                        <i class="fa fa-arrow-left"/> Dashboard
                    </a>
                </div>
            </div>

            <div class="ess-hist-body">
                <!-- Global Error Toast -->
                <t t-if="error_message">
                    <div class="position-fixed" style="z-index: 1055; right: 20px; top: 20px;">
                        <div class="toast align-items-center text-white bg-danger border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 8px;">
                            <div class="d-flex justify-content-between">
                                <div class="toast-body font-weight-bold px-4 py-3" style="font-size: 1rem;">
                                    <i class="fa fa-exclamation-circle mr-2"></i> <t t-esc="error_message"/>
                                </div>
                                <button type="button" class="close text-white mt-2 mr-2" data-bs-dismiss="toast" aria-label="Close" onclick="this.closest('.toast').classList.remove('show');" style="background: transparent; border: none; opacity: 1; font-size: 1.5rem;">
                                    <span aria-hidden="true">&amp;times;</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
                
                <!-- Global Success Toast -->
                <t t-if="success_message">
                    <div class="position-fixed" style="z-index: 1055; right: 20px; top: 20px;">
                        <div class="toast align-items-center text-white bg-success border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 8px;">
                            <div class="d-flex justify-content-between">
                                <div class="toast-body font-weight-bold px-4 py-3" style="font-size: 1rem;">
                                    <i class="fa fa-check-circle mr-2"></i> <t t-esc="success_message"/>
                                </div>
                                <button type="button" class="close text-white mt-2 mr-2" data-bs-dismiss="toast" aria-label="Close" onclick="this.closest('.toast').classList.remove('show');" style="background: transparent; border: none; opacity: 1; font-size: 1.5rem;">
                                    <span aria-hidden="true">&amp;times;</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>

                <script type="text/javascript">
                    setTimeout(function(){
                        var toasts = document.querySelectorAll('.toast.show');
                        toasts.forEach(function(t) {
                            t.classList.remove('show');
                        });
                        if (window.history.replaceState) {
                            var url = new URL(window.location.href);
                            var changed = false;
                            if (url.searchParams.has('error')) { url.searchParams.delete('error'); changed = true; }
                            if (url.searchParams.has('success')) { url.searchParams.delete('success'); changed = true; }
                            if (changed) window.history.replaceState({path: url.href}, '', url.href);
                        }
                    }, 5000);
                </script>

                <script type="text/javascript">
                    function previewProfileImage(input) {
                        if (input.files &amp;&amp; input.files[0]) {
                            var reader = new FileReader();
                            reader.onload = function (e) {
                                var img = document.getElementById('profile_img_preview');
                                if (img) {
                                    img.src = e.target.result;
                                } else {
                                    var fallback = document.getElementById('profile_img_fallback');
                                    if (fallback) {
                                        fallback.outerHTML = '&lt;img id="profile_img_preview" src="' + e.target.result + '" class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #6d28d9;"/&gt;';
                                    }
                                }
                                var delFlag = document.getElementById('delete_profile_image_flag');
                                if (delFlag) delFlag.value = "0";
                                var delBtn = document.getElementById('btn_delete_profile_img');
                                if (delBtn) delBtn.style.display = 'inline-flex';
                            }
                            reader.readAsDataURL(input.files[0]);
                        }
                    }

                    function removeProfileImage() {
                        var delFlag = document.getElementById('delete_profile_image_flag');
                        if (delFlag) delFlag.value = "1";
                        
                        var imgInput = document.getElementById('profile_image_input');
                        if (imgInput) imgInput.value = "";

                        var img = document.getElementById('profile_img_preview');
                        if (img) {
                            img.outerHTML = '&lt;div id="profile_img_fallback" class="rounded-circle shadow-sm bg-light d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 3rem; color: #ccc; border: 3px solid #6d28d9;"&gt;&lt;i class="fa fa-user"/&gt;&lt;/div&gt;';
                        }
                        var delBtn = document.getElementById('btn_delete_profile_img');
                        if (delBtn) delBtn.style.display = 'none';
                    }
                </script>

                <form action="/my/profile/update" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="delete_profile_image" id="delete_profile_image_flag" value="0"/>

                    <div class="row">
                        <!-- Professional Info & Picture Upload -->
                        <div class="col-md-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-0">
                                    <h4 style="color: var(--ess-primary);"><i class="fa fa-user-circle"/> Personal &amp; Professional Info</h4>
                                </div>
                                <div class="card-body">
                                    <!-- Interactive Profile Picture Upload & Delete -->
                                    <div class="text-center mb-4">
                                        <div style="position: relative; display: inline-block; padding: 6px;">
                                            <label for="profile_image_input" style="cursor: pointer; margin-bottom: 0; display: block;" title="Click to Change Profile Picture">
                                                <t t-if="employee.image_128 or employee.avatar_128">
                                                    <img id="profile_img_preview" t-att-src="image_data_uri(employee.avatar_128 or employee.image_128)"
                                                         class="rounded-circle shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #6d28d9;" t-att-alt="employee.name"/>
                                                </t>
                                                <t t-else="">
                                                    <div id="profile_img_fallback" class="rounded-circle shadow-sm bg-light d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px; font-size: 3rem; color: #ccc; border: 3px solid #6d28d9;">
                                                        <i class="fa fa-user"/>
                                                    </div>
                                                </t>
                                                <!-- Camera Edit Icon Badge -->
                                                <span style="position: absolute; bottom: 4px; right: 4px; background: #6d28d9; color: white; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.3); border: 2px solid white; z-index: 2;" title="Upload Photo">
                                                    <i class="fa fa-camera" style="font-size: 14px;"/>
                                                </span>
                                            </label>
                                            <!-- Trash Delete Icon Badge (Same like Backend) -->
                                            <button type="button" id="btn_delete_profile_img" onclick="removeProfileImage()" 
                                                    t-att-style="'display: flex;' if employee.image_128 else 'display: none;'"
                                                    style="position: absolute; top: 4px; right: 4px; background: #ef4444; color: white; width: 32px; height: 32px; border-radius: 50%; border: 2px solid white; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 8px rgba(0,0,0,0.3); cursor: pointer; z-index: 3;" title="Delete Profile Picture">
                                                <i class="fa fa-trash" style="font-size: 13px;"/>
                                            </button>
                                        </div>
                                        <input type="file" name="profile_image" id="profile_image_input" accept="image/*" class="d-none" onchange="previewProfileImage(this)"/>
                                        <div class="text-muted small mt-2">
                                            <i class="fa fa-info-circle me-1"/> Click photo to upload | Click <i class="fa fa-trash text-danger"/> to delete
                                        </div>
                                        <h5 class="mt-2 mb-0"><t t-esc="employee.name"/></h5>
                                        <p class="text-muted"><t t-esc="employee.job_title or (employee.job_id and employee.job_id.name) or 'Employee'"/></p>
                                    </div>
                                    <hr/>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted font-weight-bold">Department</div>
                                        <div class="col-7"><t t-esc="employee.department_id.name or 'N/A'"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted font-weight-bold">Manager</div>
                                        <div class="col-7"><t t-esc="employee.parent_id.name or 'N/A'"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted font-weight-bold">Work Email</div>
                                        <div class="col-7"><t t-esc="employee.work_email or 'N/A'"/></div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-5 text-muted font-weight-bold">Location</div>
                                        <div class="col-7"><t t-esc="employee.work_location_id.name or 'N/A'"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Editable Contact Details -->
                        <div class="col-md-6 mb-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="card-header bg-white border-0 pt-4 pb-0">
                                    <h4 style="color: var(--ess-primary);"><i class="fa fa-phone"/> Contact &amp; Emergency Details</h4>
                                    <p class="text-muted small">Update your phone numbers and emergency contacts.</p>
                                </div>
                                <div class="card-body">
                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold"><i class="fa fa-phone me-1 text-primary"/> Work Phone</label>
                                        <input type="text" class="form-control" name="work_phone" 
                                               t-att-value="employee.work_phone or ''" placeholder="E.g. +1 555-0199"/>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold"><i class="fa fa-mobile me-1 text-primary"/> Mobile Phone</label>
                                        <input type="text" class="form-control" name="mobile_phone" 
                                               t-att-value="employee.mobile_phone or ''" placeholder="E.g. +1 555-0198"/>
                                    </div>

                                    <hr class="my-4"/>

                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold"><i class="fa fa-user-plus me-1 text-danger"/> Emergency Contact Name</label>
                                        <input type="text" class="form-control" name="emergency_contact" 
                                               t-att-value="employee.emergency_contact or ''" placeholder="E.g. John Doe (Brother)"/>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label class="font-weight-bold"><i class="fa fa-phone-square me-1 text-danger"/> Emergency Phone</label>
                                        <input type="text" class="form-control" name="emergency_phone" 
                                               t-att-value="employee.emergency_phone or ''" placeholder="E.g. +1 555-1234"/>
                                    </div>

                                    <div class="mt-4 text-right">
                                        <button type="submit" class="btn font-weight-bold px-4 py-2" style="background: var(--ess-primary); color: white; border-radius: 8px;">
                                            <i class="fa fa-save me-1"/> Save Changes
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

            </div>

        </t>
    </template>
</odoo>
