<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_timesheets_override" inherit_id="hr_timesheet.portal_my_timesheets" name="My Timesheets">
        <xpath expr="//t[@t-call='portal.portal_layout']" position="replace">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <div class="ess-portal-fullwidth">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Timesheets</t>
                </t>
                
                <div class="ess-hist-hero" style="margin-top: 0; margin-bottom: 20px;">
                <div class="ess-hist-hero-inner">
                    <div>
                        <div class="ess-hist-hero-title">
                            <i class="fa fa-calendar-check-o"/> My Timesheets
                        </div>
                        <div class="ess-hist-hero-sub">Log and track your time</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="ess-hist-back-btn" data-bs-toggle="modal" data-bs-target="#newTimesheetModal">
                            <i class="fa fa-plus"/> Log Time
                        </button>
                        <a href="/my/dashboard" class="ess-hist-back-btn ml-3">
                            <i class="fa fa-arrow-left"/> Dashboard
                        </a>
                    </div>
                </div>
            </div>

            <!-- Global Error Toast -->
            <t t-if="error_message">
                <div class="position-fixed" style="z-index: 1055; right: 20px; top: 20px;">
                    <div class="toast align-items-center text-white bg-danger border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 8px;">
                        <div class="d-flex justify-content-between">
                            <div class="toast-body font-weight-bold px-4 py-3" style="font-size: 1rem;">
                                <i class="fa fa-exclamation-circle mr-2"></i> <t t-esc="error_message"/>
                            </div>
                            <button type="button" class="close text-white mt-2 mr-2" data-bs-dismiss="toast" aria-label="Close" onclick="this.closest('.toast').classList.remove('show');" style="background: transparent; border: none; opacity: 1; font-size: 1.5rem;">
                                <span aria-hidden="true">&amp;times;</span>
                            </button>
                        </div>
                    </div>
                </div>
                <script type="text/javascript">
                    setTimeout(function(){
                        var t = document.querySelector('.toast.show');
                        if(t) t.classList.remove('show');
                        if (window.history.replaceState) {
                            var url = new URL(window.location.href);
                            if (url.searchParams.has('error')) {
                                url.searchParams.delete('error');
                                window.history.replaceState({path: url.href}, '', url.href);
                            }
                        }
                    }, 5000);
                </script>
            </t>

            <div class="ess-hist-body">
                <div class="ess-hist-table-wrap">
                    <table class="ess-hist-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Project</th>
                                <th>Task</th>
                                <th>Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="not grouped_timesheets">
                                <tr>
                                    <td colspan="5" class="ess-empty-row">
                                        <i class="fa fa-inbox fa-2x"/>
                                        <div>No timesheets logged yet.</div>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="grouped_timesheets">
                                <t t-foreach="grouped_timesheets" t-as="timesheets_with_hours">
                                    <t t-set="timesheets_group" t-value="timesheets_with_hours[0]"/>
                                    <t t-set="hours_spent" t-value="timesheets_with_hours[1]"/>
                                    
                                    <tr t-if="groupby != 'none'" class="table-light font-weight-bold" style="background: var(--ess-light); color: var(--ess-primary);">
                                        <t t-if="groupby == 'project_id'">
                                            <td colspan="4">Project: <t t-esc="timesheets_group[0].project_id.name"/></td>
                                        </t>
                                        <t t-elif="groupby == 'task_id'">
                                            <td colspan="4">Task: <t t-esc="timesheets_group[0].task_id.name if timesheets_group[0].task_id else 'No Task'"/></td>
                                        </t>
                                        <t t-elif="groupby == 'date'">
                                            <td colspan="4">Date: <t t-esc="timesheets_group[0].date"/></td>
                                        </t>
                                        <t t-elif="groupby == 'employee_id'">
                                            <td colspan="4">Employee: <t t-esc="timesheets_group[0].employee_id.name"/></td>
                                        </t>
                                        <t t-else="">
                                            <td colspan="4">Group</td>
                                        </t>
                                        <td><t t-esc="hours_spent" t-options='{"widget": "float_time"}'/> Hours</td>
                                    </tr>
                                    
                                    <t t-foreach="timesheets_group" t-as="ts">
                                        <tr>
                                            <td class="font-weight-bold"><t t-esc="ts.date"/></td>
                                            <td><t t-esc="ts.name"/></td>
                                            <td>
                                                <span class="badge badge-light text-primary"><t t-esc="ts.project_id.name if ts.project_id else ''"/></span>
                                            </td>
                                            <td>
                                                <span class="text-muted"><t t-esc="ts.task_id.name if ts.task_id else ''"/></span>
                                            </td>
                                            <td>
                                                <span class="ess-hrs-val"><t t-esc="ts.unit_amount" t-options='{"widget": "float_time"}'/></span>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- New Timesheet Modal -->
            <div class="modal fade" id="newTimesheetModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <form action="/my/timesheets/create" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                            
                            <div class="modal-header">
                                <h5 class="modal-title">Log Time</h5>
                                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&amp;times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="form-group">
                                    <label>Date</label>
                                    <input type="date" class="form-control" name="date" required="1" t-att-value="datetime.date.today().strftime('%Y-%m-%d')"/>
                                </div>
                                <div class="form-group">
                                    <label>Project</label>
                                    <select class="form-control" name="project_id" id="ts_project_id" required="1">
                                        <option value="">-- Select Project --</option>
                                        <t t-foreach="projects" t-as="proj">
                                            <option t-att-value="proj.id"><t t-esc="proj.name"/></option>
                                        </t>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Task (Optional)</label>
                                    <select class="form-control" name="task_id" id="ts_task_id" disabled="1">
                                        <option value="">-- Select Project First --</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Hours Spent</label>
                                    <input type="text" class="form-control" name="unit_amount_str" required="1" placeholder="00:00" pattern="^([0-9]{1,2}):([0-5][0-9])$" title="Please enter time in HH:MM format (e.g., 01:30)"/>
                                </div>
                                <div class="form-group">
                                    <label>Description</label>
                                    <input type="text" class="form-control" name="name" required="1" placeholder="What did you do?"/>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn" style="background: var(--ess-primary); color: white;">Save Timesheet</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    const projectSelect = document.getElementById('ts_project_id');
                    const taskSelect = document.getElementById('ts_task_id');
                    
                    if(projectSelect &amp;&amp; taskSelect) {
                        projectSelect.addEventListener('change', function() {
                            const projectId = this.value;
                            if(!projectId) {
                                taskSelect.innerHTML = '<option value="">-- Select Project First --</option>';
                                taskSelect.disabled = true;
                                return;
                            }
                            
                            taskSelect.disabled = true;
                            taskSelect.innerHTML = '<option value="">Loading tasks...</option>';
                            
                            fetch('/my/timesheets/get_tasks_by_project', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    jsonrpc: '2.0',
                                    method: 'call',
                                    params: { project_id: projectId }
                                })
                            }).then(response => response.json())
                              .then(data => {
                                  taskSelect.innerHTML = '<option value="">-- No Task --</option>';
                                  if(data.result &amp;&amp; data.result.length > 0) {
                                      data.result.forEach(task => {
                                          taskSelect.innerHTML += `<option value="${task.id}">${task.name}</option>`;
                                      });
                                  }
                                  taskSelect.disabled = false;
                              });
                        });
                    }
                });
            </script>
            
            <div t-if="pager" class="o_portal_pager text-center mt-4 mb-4">
                <t t-call="portal.pager"/>
            </div>
            </div>
        </t>
        </xpath>
    </template>
</odoo>
