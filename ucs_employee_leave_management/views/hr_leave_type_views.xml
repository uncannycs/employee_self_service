<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_holiday_status_form_inherit_mandatory" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.mandatory</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='support_document']" position="after">
                <field name="mandatory_attachment" string="Mandatory Attachment Threshold"/>
                <field name="mandatory_attachment_min_days" string="Min Days for Mandatory Attachment" invisible="not mandatory_attachment"/>
            </xpath>
        </field>
    </record>
</odoo>
