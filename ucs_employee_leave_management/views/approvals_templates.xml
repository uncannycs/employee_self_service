<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="leave_approvals_tabs" inherit_id="ucs_portal_self_service.approvals_submenu">
        <xpath expr="." position="inside">
            <t t-if="request.env.user.has_group('ucs_employee_leave_management.group_portal_leave_approval_manager')">
                <li class="nav-item" role="presentation">
                    <a href="#leave" class="ess-sub-nav-item nav-link" t-att-class="'ess-sub-nav-item nav-link ' + ('active' if request.params.get('tab', 'leave') == 'leave' else '')" data-bs-toggle="tab" role="tab"
                       style="background-color: transparent !important; padding: 15px 20px; color: #4c1d95 !important; font-weight: bold; border-bottom: 3px solid transparent; text-decoration: none; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                        Leave
                    </a>
                </li>
            </t>
        </xpath>
    </template>

    <template id="leave_approvals_content" inherit_id="ucs_portal_self_service.approvals_content">
        <xpath expr="." position="inside">
            <t t-if="request.env.user.has_group('ucs_employee_leave_management.group_portal_leave_approval_manager')">
                <div class="tab-pane fade" t-att-class="'tab-pane fade ' + ('show active' if request.params.get('tab', 'leave') == 'leave' else '')" id="leave" role="tabpanel">
                    <div class="ess-hist-table-wrap">
                        <h4 class="mb-3 px-3 pt-3" style="color: var(--ess-primary);"><i class="fa fa-hourglass-half"/> Pending Approvals</h4>
                        <table class="ess-hist-table">
                            <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Date From</th>
                                        <th>Date To</th>
                                        <th>Leave Type</th>
                                        <th>Days</th>
                                        <th>Attachment</th>
                                        <th>Status</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="leaves">
                                        <t t-foreach="leaves" t-as="leave">
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img t-attf-src="/web/image/hr.employee/#{leave.employee_id.id}/avatar_128" 
                                                             style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover; margin-right: 10px;"/>
                                                        <span class="font-weight-bold text-dark"><t t-esc="leave.employee_id.name"/></span>
                                                    </div>
                                                </td>
                                                <td class="font-weight-bold"><t t-esc="leave.request_date_from.strftime('%d/%m/%Y') if leave.request_date_from else ''"/></td>
                                                <td class="font-weight-bold"><t t-esc="leave.request_date_to.strftime('%d/%m/%Y') if leave.request_date_to else ''"/></td>
                                                <td>
                                                    <span class="badge badge-light text-primary"><t t-esc="leave.holiday_status_id.name"/></span>
                                                    <t t-if="leave.name">
                                                        <small class="text-muted d-block mt-1"><i class="fa fa-info-circle me-1"/> <t t-esc="leave.name"/></small>
                                                    </t>
                                                    <t t-if="leave.cancellation_requested and leave.cancellation_reason">
                                                        <div class="p-2 mt-2 rounded border border-warning bg-warning-subtle text-dark small" style="background-color: #fff8e6; border-left: 3px solid #ffc107 !important;">
                                                            <strong><i class="fa fa-commenting me-1"/> Cancellation Reason:</strong>
                                                            <div class="font-italic text-dark mt-1" style="white-space: pre-wrap;"><t t-esc="leave.cancellation_reason"/></div>
                                                        </div>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="leave.request_unit_hours or leave.holiday_status_id.request_unit == 'hour'">
                                                        <t t-esc="int(round((leave.number_of_hours or (leave.number_of_days * 8.0)) * 60))"/> min
                                                    </t>
                                                    <t t-elif="leave.request_unit_half">
                                                        <t t-esc="leave.number_of_days"/>
                                                        <small class="text-muted d-block">
                                                            (<t t-esc="'Morning' if leave.request_date_from_period == 'am' else 'Afternoon'"/>)
                                                        </small>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="leave.number_of_days"/>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-set="leave_atts" t-value="leave.supported_attachment_ids or leave.attachment_ids or request.env['ir.attachment'].sudo().search([('res_model', '=', 'hr.leave'), ('res_id', '=', leave.id)])"/>
                                                    <t t-if="leave_atts">
                                                        <t t-foreach="leave_atts" t-as="att">
                                                            <a t-attf-href="/my/leaves/attachment/#{att.id}" class="btn btn-sm btn-outline-primary shadow-sm me-1 mb-1" style="border-radius: 6px; font-size: 0.78rem;" t-att-title="att.name" target="_blank">
                                                                <i class="fa fa-paperclip me-1"/> <t t-esc="att.name[:14] + '...' if len(att.name) &gt; 16 else att.name"/>
                                                            </a>
                                                        </t>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="text-muted small">-</span>
                                                    </t>
                                                </td>
                                                <td>
                                                    <t t-if="leave.cancellation_requested">
                                                        <span class="badge bg-warning text-dark"><i class="fa fa-exclamation-circle me-1"/> Cancellation Requested</span>
                                                    </t>
                                                    <t t-elif="leave.state in ['validate', 'validate1']">
                                                        <span class="badge bg-success text-white">Approved</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="badge bg-warning text-white">To Approve</span>
                                                    </t>
                                                </td>
                                                <td class="text-center">
                                                    <t t-if="leave.cancellation_requested">
                                                        <a t-attf-href="/my/approvals/cancellation/approve/{{ leave.id }}" class="btn btn-sm btn-danger mr-2" onclick="return confirm('Approve leave cancellation request? This will cancel the leave and restore the employee leave balance.');" title="Approve Cancellation">
                                                            <i class="fa fa-check"/> Approve Cancellation
                                                        </a>
                                                        <a t-attf-href="/my/approvals/cancellation/reject/{{ leave.id }}" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Reject cancellation request and keep leave approved?');" title="Reject Cancellation Request">
                                                            <i class="fa fa-times"/> Reject Request
                                                        </a>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-if="leave.state == 'confirm'">
                                                            <a t-attf-href="/my/approvals/approve/{{ leave.id }}" class="btn btn-sm btn-success mr-2" onclick="return confirm('Are you sure you want to approve this leave request?');" title="Approve">
                                                                <i class="fa fa-check"/> Approve
                                                            </a>
                                                        </t>
                                                        <a t-attf-href="/my/approvals/refuse/{{ leave.id }}" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to refuse/reject this leave request?');" title="Refuse">
                                                            <i class="fa fa-times"/> Refuse / Reject
                                                        </a>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-else="">
                                        <tr>
                                            <td colspan="8" class="ess-empty-row">
                                                <i class="fa fa-check-circle-o fa-2x"/>
                                                <div>No pending approvals found. You're all caught up!</div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
