<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_attendance_history_regularize" inherit_id="ucs_portal_self_service.portal_attendance_history" name="Attendance History Regularize">
        <!-- Add empty header for the action column -->
        <xpath expr="//table[hasclass('ess-hist-table')]/thead/tr/th[last()]" position="after">
            <th class="text-right"></th>
        </xpath>

        <!-- Add the Regularize button and modal to each attendance row -->
        <xpath expr="//span[hasclass('ess-hrs-val')]/.." position="after">
            <td class="text-right">
                <t t-set="existing_req" t-value="request.env['attendance.regularize'].sudo().search([('attendance_id', '=', att['id'])], order='id desc', limit=1)"/>
                <t t-if="not existing_req or existing_req.state == 'draft'">
                    <button type="button" class="btn btn-sm shadow-sm" style="background-color: transparent; color: #8b5cf6; border: 1px solid #8b5cf6; border-radius: 4px; font-weight: 600; font-size: 0.8rem; padding: 0.25rem 0.75rem; transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='#8b5cf6'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#8b5cf6';" data-bs-toggle="modal" t-attf-data-bs-target="#regularizeModal_{{ att_index }}">
                        <i class="fa fa-edit mr-1"/> Regularize
                    </button>
                    
                    <!-- Regularize Modal -->
                    <div class="modal fade text-left" t-attf-id="regularizeModal_{{ att_index }}" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header bg-light">
                                    <h5 class="modal-title font-weight-bold"><i class="fa fa-pencil-square-o mr-2"/>Regularize Attendance</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                        <div class="d-flex justify-content-around align-items-center mb-3 p-2 rounded shadow-sm" style="background-color: #e0f2fe; border: 1px solid #bae6fd;">
                                            <div class="text-center px-2">
                                                <div class="text-muted mb-1" style="font-size: 0.75rem;"><i class="fa fa-sign-in text-success mr-1"/> Check In</div>
                                                <div class="font-weight-bold text-dark" style="font-size: 0.85rem;"><t t-esc="att['check_in'].split(' ', 1)[1] if att['check_in'] else '- -'"/></div>
                                            </div>
                                            <div class="text-center px-3" style="border-left: 1px solid #bae6fd; border-right: 1px solid #bae6fd;">
                                                <div class="text-muted mb-1" style="font-size: 0.75rem;"><i class="fa fa-clock-o text-primary mr-1"/> Total Time</div>
                                                <div class="font-weight-bold text-primary" style="font-size: 0.9rem;"><t t-esc="att['worked_hours']"/></div>
                                            </div>
                                            <div class="text-center px-2">
                                                <div class="text-muted mb-1" style="font-size: 0.75rem;"><i class="fa fa-sign-out text-danger mr-1"/> Check Out</div>
                                                <div class="font-weight-bold text-dark" style="font-size: 0.85rem;">
                                                    <t t-if="att['check_out'] == 'Ongoing'">
                                                        <span class="text-warning">Ongoing</span>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="att['check_out'].split(' ', 1)[1] if att['check_out'] else '- -'"/>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    <t t-set="employee" t-value="request.env['hr.employee'].sudo().search([('user_id', '=', request.env.user.id)], limit=1)"/>
                                    <t t-set="req_left" t-value="(employee.regularize_request_assign - employee.regularize_req_used) if employee else 0"/>
                                    
                                    <t t-set="prev_co" t-value="attendances[att_index + 1]['check_out'] if (att_index + 1) &lt; len(attendances) else ''"/>
                                    <t t-set="next_ci" t-value="attendances[att_index - 1]['check_in'] if att_index &gt; 0 else ''"/>
                                    
                                    <t t-if="req_left > 0">
                                        <div class="alert alert-info py-2 mb-3" style="font-size: 0.85rem;">
                                            <i class="fa fa-info-circle mr-2"/> You have <strong><t t-esc="req_left"/></strong> regularization request(s) left this month.
                                        </div>
                                        <form action="/my/attendance/regularize_request" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <!-- Backend references -->
                                            <input type="hidden" name="attendance_id" t-att-value="att['id']"/>
                                            <input type="hidden" name="check_in_old" t-att-value="att['check_in']"/>
                                            <input type="hidden" name="check_out_old" t-att-value="att['check_out']"/>
                                            

                                            <div class="mb-3">
                                                <label class="form-label font-weight-bold" style="font-size: 0.9rem;">Regularize Type <span class="text-danger">*</span></label>
                                                <select class="form-select form-control" name="regularize_type" required="required" 
                                                        t-attf-id="reg_type_{{ att_index }}"
                                                        t-att-data-index="att_index"
                                                        t-att-data-is-ongoing="att['check_out'] == 'Ongoing'"
                                                        t-attf-onchange="
                                                            var isOngoing = this.getAttribute('data-is-ongoing') === 'True';
                                                            document.getElementById('check_in_div_{{ att_index }}').style.display = (this.value === 'check_in') ? 'block' : 'none';
                                                            document.getElementById('check_out_div_{{ att_index }}').style.display = (this.value === 'check_out' &amp;&amp; !isOngoing) ? 'block' : 'none';
                                                            document.getElementById('checkout_warning_{{ att_index }}').style.display = (this.value === 'check_out' &amp;&amp; isOngoing) ? 'block' : 'none';
                                                            validateRegularize('{{ att_index }}', '{{ att['check_in'] }}', '{{ att['check_out'] }}', '{{ prev_co }}', '{{ next_ci }}');
                                                        ">
                                                    <option value="">-- Select --</option>
                                                    <option value="check_in">Check-In</option>
                                                    <option value="check_out">Check-Out</option>
                                                </select>
                                            </div>

                                            <div class="mb-3" t-attf-id="check_in_div_{{ att_index }}" style="display: none;">
                                                <div class="d-flex align-items-center">
                                                    <div style="flex: 1;">
                                                        <label class="form-label font-weight-bold text-muted mb-1" style="font-size: 0.8rem;">Current Check-In Time</label>
                                                        <div class="form-control bg-light text-muted" style="text-align: center;"><t t-esc="att['check_in'].split(' ', 1)[1] if att['check_in'] else ''"/></div>
                                                    </div>
                                                    <div class="mx-3 pt-4"><i class="fa fa-long-arrow-right text-muted fa-lg"/></div>
                                                    <div style="flex: 1;">
                                                        <label class="form-label font-weight-bold text-primary mb-1" style="font-size: 0.8rem;">New Check-In Time</label>
                                                        <input type="time" class="form-control border-primary" name="check_in_new" t-attf-oninput="validateRegularize('{{ att_index }}', '{{ att['check_in'] }}', '{{ att['check_out'] }}', '{{ prev_co }}', '{{ next_ci }}')"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mb-3" t-attf-id="check_out_div_{{ att_index }}" style="display: none;">
                                                <div class="d-flex align-items-center">
                                                    <div style="flex: 1;">
                                                        <label class="form-label font-weight-bold text-muted mb-1" style="font-size: 0.8rem;">Current Check-Out Time</label>
                                                        <div class="form-control bg-light text-muted" style="text-align: center;"><t t-esc="att['check_out'].split(' ', 1)[1] if att['check_out'] and att['check_out'] != 'Ongoing' else att['check_out']"/></div>
                                                    </div>
                                                    <div class="mx-3 pt-4"><i class="fa fa-long-arrow-right text-muted fa-lg"/></div>
                                                    <div style="flex: 1;">
                                                        <label class="form-label font-weight-bold text-primary mb-1" style="font-size: 0.8rem;">New Check-Out Time</label>
                                                        <input type="time" class="form-control border-primary" name="check_out_new" t-attf-oninput="validateRegularize('{{ att_index }}', '{{ att['check_in'] }}', '{{ att['check_out'] }}', '{{ prev_co }}', '{{ next_ci }}')"/>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div t-attf-id="checkout_warning_{{ att_index }}" class="alert alert-warning py-2 mb-3" style="display: none; font-size: 0.85rem;">
                                                <i class="fa fa-exclamation-triangle mr-2"/><strong>Note:</strong> Please complete your Check-Out before you can regularize it.
                                            </div>
                                            <div t-attf-id="time_error_{{ att_index }}" class="alert alert-danger py-2 mb-3" style="display: none; font-size: 0.85rem;">
                                                <i class="fa fa-exclamation-circle mr-2"/> <span t-attf-id="time_error_text_{{ att_index }}"></span>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label font-weight-bold" style="font-size: 0.9rem;">Reason for Regularization <span class="text-danger">*</span></label>
                                                <textarea class="form-control" name="reason" rows="2" required="required" placeholder="Provide a valid reason for regularization..."></textarea>
                                            </div>
                                            
                                            <div class="text-right">
                                                <button type="submit" t-attf-id="submit_btn_{{ att_index }}" class="btn btn-primary" style="background-color: #8b5cf6; border-color: #8b5cf6;">Submit Request</button>
                                                <button type="button" class="btn btn-secondary ml-2" data-bs-dismiss="modal">Cancel</button>
                                            </div>
                                        </form>
                                    </t>
                                    <t t-else="">
                                        <div class="alert alert-danger py-3 mb-3 text-center" style="font-size: 0.9rem;">
                                            <i class="fa fa-exclamation-triangle fa-2x mb-2 d-block"/>
                                            <strong>Your request is no longer available for this month.</strong>
                                        </div>
                                        <div class="text-right">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-elif="existing_req.state == 'hr_approve'">
                    <span class="d-inline-block text-center" style="border: 1px solid #10b981; color: #10b981; border-radius: 4px; font-weight: 600; font-size: 0.8rem; padding: 0.25rem 0.75rem; background-color: rgba(16, 185, 129, 0.1);"><i class="fa fa-check-circle mr-1"/> Approved</span>
                </t>
                <t t-elif="existing_req.state == 'reject'">
                    <span class="d-inline-block text-center" style="border: 1px solid #ef4444; color: #ef4444; border-radius: 4px; font-weight: 600; font-size: 0.8rem; padding: 0.25rem 0.75rem; background-color: rgba(239, 68, 68, 0.1);"><i class="fa fa-times-circle mr-1"/> Rejected</span>
                </t>
                <t t-else="">
                    <span class="d-inline-block text-center" style="border: 1px solid #3b82f6; color: #3b82f6; border-radius: 4px; font-weight: 600; font-size: 0.8rem; padding: 0.25rem 0.75rem; background-color: rgba(59, 130, 246, 0.1);"><i class="fa fa-paper-plane mr-1"/> Submitted</span>
                </t>
            </td>
        </xpath>

        <!-- Update colspan for the empty state row -->
        <xpath expr="//td[hasclass('ess-empty-row')]" position="attributes">
            <attribute name="colspan">4</attribute>
        </xpath>
        
        <xpath expr="." position="inside">
            <script>
                function validateRegularize(index, ci_old, co_old, prev_co, next_ci) {
                    var typeSelect = document.getElementById('reg_type_' + index);
                    var type = typeSelect ? typeSelect.value : '';
                    var ci_new_input = document.querySelector('#check_in_div_' + index + ' input[name="check_in_new"]');
                    var co_new_input = document.querySelector('#check_out_div_' + index + ' input[name="check_out_new"]');
                    var ci_new = ci_new_input ? ci_new_input.value : '';
                    var co_new = co_new_input ? co_new_input.value : '';
                    var submitBtn = document.getElementById('submit_btn_' + index);
                    var errorDiv = document.getElementById('time_error_' + index);
                    var errorText = document.getElementById('time_error_text_' + index);
                    
                    var isOngoing = co_old === 'Ongoing';
                    
                    function get24(time12) {
                        if(!time12 || time12==='Ongoing') return '';
                        var p = time12.split(' ');
                        if(p.length &lt; 3) return p[1] || '';
                        var tp = p[1].split(':');
                        var h = parseInt(tp[0]);
                        if(p[2].toUpperCase() === 'PM' &amp;&amp; h &lt; 12) h += 12;
                        if(p[2].toUpperCase() === 'AM' &amp;&amp; h === 12) h = 0;
                        return (h&lt;10?'0':'')+h+':'+tp[1];
                    }
                    
                    var ci_24 = get24(ci_old);
                    var co_24 = get24(co_old);
                    
                    var ci_date = ci_old ? ci_old.split(' ')[0] : '';
                    var prev_date = prev_co ? prev_co.split(' ')[0] : '';
                    var next_date = next_ci ? next_ci.split(' ')[0] : '';
                    
                    var prev_co_24 = (prev_co &amp;&amp; prev_date === ci_date) ? get24(prev_co) : '';
                    var next_ci_24 = (next_ci &amp;&amp; next_date === ci_date) ? get24(next_ci) : '';
                    
                    var error = '';
                    if (type === 'check_in' &amp;&amp; ci_new) {
                        if (!isOngoing &amp;&amp; co_24 &amp;&amp; ci_new &gt; co_24) {
                            var co_p = co_old.split(' ');
                            error = 'Check-In time cannot be later than Check-Out time (' + (co_p[1]+' '+co_p[2]) + ').';
                        } else if (prev_co_24 &amp;&amp; ci_new &lt; prev_co_24) {
                            var p_co_p = prev_co.split(' ');
                            error = 'You have already checked out at ' + (p_co_p[1]+' '+p_co_p[2]) + ' on ' + prev_date + ', you cannot set a Check-In time before this.';
                        }
                    } else if (type === 'check_out' &amp;&amp; co_new) {
                        if (ci_24 &amp;&amp; co_new &lt; ci_24) {
                            var ci_p = ci_old.split(' ');
                            error = 'Check-Out time cannot be earlier than Check-In time (' + (ci_p[1]+' '+ci_p[2]) + ').';
                        } else if (next_ci_24 &amp;&amp; co_new &gt; next_ci_24) {
                            var n_ci_p = next_ci.split(' ');
                            error = 'You have already checked in at ' + (n_ci_p[1]+' '+n_ci_p[2]) + ' on ' + next_date + ', you cannot set a Check-Out time after this.';
                        }
                    }
                    
                    if (error) {
                        errorText.innerText = error;
                        errorDiv.style.display = 'block';
                        submitBtn.disabled = true;
                    } else {
                        errorDiv.style.display = 'none';
                        if (type === 'check_out' &amp;&amp; isOngoing) {
                            submitBtn.disabled = true;
                        } else {
                            submitBtn.disabled = false;
                        }
                    }
                }
            </script>
        </xpath>
    </template>

</odoo>
