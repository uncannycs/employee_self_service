<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_regularize" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.regularize</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='overtime_settings']" position="inside">
                <setting title="Regularize Requests" string="Regularize Requests Per Month" company_dependent="1" help="Employee can per month regularize request, this is also renew start month 1st date" groups="ucs_attendance_regularize.group_attendance_regularize_hr_admin">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="regularize_request_per_month" class="col-lg-3 o_light_label"/>
                            <field name="regularize_request_per_month" required="1" class="col-lg-3"/>
                            <button name="action_update_regularize_requests" type="object" string="Apply to all Employees" class="btn-link" icon="fa-arrow-right"/>
                        </div>
                        <div class="text-muted mt8">
                            Clicking 'Apply' assigns this limit to all employees. Employees who already used requests will simply retain (Assigned - Used) left.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
