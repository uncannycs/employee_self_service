<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Privilege for Portal Regularize Approvals -->
        <record model="res.groups.privilege" id="privilege_portal_regularize_approvals">
            <field name="name">Portal Regularize Approvals</field>
            <field name="category_id" ref="ucs_portal_self_service.module_category_portal_approvals"/>
        </record>

        <!-- Manager Group -->
        <record id="group_attendance_regularize_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_portal_regularize_approvals"/>
            <field name="comment">Can approve regularization for their subordinates.</field>
        </record>

        <!-- Admin Group -->
        <record id="group_attendance_regularize_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="privilege_portal_regularize_approvals"/>
            <field name="implied_ids" eval="[(4, ref('group_attendance_regularize_manager'))]"/>
            <field name="comment">Can approve all regularizations.</field>
        </record>
        
        <!-- HR/Admin Approvals Group -->
        <record id="group_attendance_regularize_hr_admin" model="res.groups">
            <field name="name">HR/Admin Approvals</field>
        </record>
    </data>

    <data noupdate="1">
        <!-- Record Rules -->
        <!-- Manager can see only their subordinates' requests (or their own) -->
        <record id="rule_attendance_regularize_manager" model="ir.rule">
            <field name="name">Manager Regularize Approvals</field>
            <field name="model_id" ref="model_attendance_regularize"/>
            <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_attendance_regularize_manager'))]"/>
        </record>

        <!-- Admin can see all requests -->
        <record id="rule_attendance_regularize_admin" model="ir.rule">
            <field name="name">Admin Regularize Approvals</field>
            <field name="model_id" ref="model_attendance_regularize"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_attendance_regularize_admin'))]"/>
        </record>
    </data>
</odoo>
