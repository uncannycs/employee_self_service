<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Attendance Regularization -->
        <record id="seq_attendance_regularize" model="ir.sequence">
            <field name="name">Attendance Regularization Request</field>
            <field name="code">attendance.regularize</field>
            <field name="prefix">AR/%(year)s/%(month)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
