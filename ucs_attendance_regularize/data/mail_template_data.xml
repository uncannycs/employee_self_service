<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Email Template: Submitted to Manager -->
        <record id="email_template_attendance_regularize_submit" model="mail.template">
            <field name="name">Attendance Regularization: Submitted (To Manager)</field>
            <field name="model_id" ref="ucs_attendance_regularize.model_attendance_regularize"/>
            <field name="subject">Attendance Regularization Request from {{ object.employee_id.name }}</field>

            <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello <t t-out="object.manager_id.name or 'Manager'"></t>,<br/><br/>
                    You have a new Attendance Regularization request pending your approval.<br/><br/>
                    <strong>Employee:</strong> <t t-out="object.employee_id.name"></t><br/>
                    <strong>Regularize Type:</strong> <t t-out="dict(object.fields_get(allfields=['regularize_type'])['regularize_type']['selection'])[object.regularize_type]"></t><br/>
                    <strong>Reason:</strong> <t t-out="object.reason"></t><br/>
                    <br/>
                    Please review and approve this request from your Portal Approvals section.
                    <br/><br/>
                    Thank you!
                </p>
            </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template: Manager Approved to HR -->
        <record id="email_template_attendance_regularize_manager_approve" model="mail.template">
            <field name="name">Attendance Regularization: Manager Approved (To HR)</field>
            <field name="model_id" ref="ucs_attendance_regularize.model_attendance_regularize"/>
            <field name="subject">Attendance Regularization Approved by Manager: {{ object.employee_id.name }}</field>

            <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello HR Team,<br/><br/>
                    An Attendance Regularization request for <strong><t t-out="object.employee_id.name"></t></strong> has been approved by their manager, <t t-out="object.manager_id.name"></t>, and is now pending your final approval.<br/><br/>
                    <strong>Regularize Type:</strong> <t t-out="dict(object.fields_get(allfields=['regularize_type'])['regularize_type']['selection'])[object.regularize_type]"></t><br/>
                    <strong>Reason:</strong> <t t-out="object.reason"></t><br/>
                    <br/>
                    Please review and provide final approval from your Portal Approvals section.
                    <br/><br/>
                    Thank you!
                </p>
            </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
